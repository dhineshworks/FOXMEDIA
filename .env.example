# Supabase Public Configuration (Safe for frontend exposure via Vite)
# Find these in your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# IMPORTANT SECURITY NOTE:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend code or .env files.
# All security is handled via Row Level Security (RLS) & PostgreSQL RPC functions.
